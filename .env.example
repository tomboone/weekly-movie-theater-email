REGAL_CINEMA_ID=0985
TMDB_API_KEY=your_tmdb_bearer_token
ACS_CONNECTION_STRING=your_acs_connection_string
EMAIL_FROM=DoNotReply@your-acs-domain.azurecomm.net
EMAIL_TO=you@example.com
EXCLUDE_PATTERNS=Met Opera,NT Live,Bolshoi Ballet,Fathom,MARS:,Open Cap/Eng Sub
SEND_EMPTY_EMAIL=false
MOVIE_STATE_PATH=./data/movie_state.json
SCHEDULE_CRON=0 10 * * 5
TRIGGER_API_KEY=your_trigger_api_key
SCHEDULE_TIMEZONE=America/New_York
# Optional: Uptime Kuma push monitor URL, reported after every run (status up/down)
KUMA_PUSH_URL=
# Prod only (docker-compose.prod.yml): the Tailscale sidecar. A one-time tagged auth key for the first
# start; blank it once the node has joined. TS_EXTRA_ARGS empty uses --advertise-tags=tag:app.
TS_AUTHKEY=
TS_EXTRA_ARGS=
